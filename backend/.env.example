# MySQL connection
MYSQL_USER=root
# Leave empty when the local MySQL root user has no password.
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=restaurant_db

# Optional: use this instead of the MYSQL_* values
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/restaurant_db

SECRET_KEY=change-this-secret
JWT_SECRET_KEY=change-this-jwt-secret
